{
  "name": "heyneighbor-supabase",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase migrations, local integration tests, and seed configuration for HeyNeighbor",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/auth.test.ts tests/database-functions.test.ts tests/member-roles.test.ts tests/rls.test.ts tests/storage.test.ts",
    "test:database-functions": "node --experimental-strip-types --test tests/database-functions.test.ts",
    "test:rls": "node --experimental-strip-types --test tests/rls.test.ts",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.ts",
    "test:storage": "node --experimental-strip-types --test tests/storage.test.ts",
    "test:member-roles": "node --experimental-strip-types --test tests/member-roles.test.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.98.0",
    "@supabase/supabase-js": "^2.117.0",
    "@types/node": "^22.19.2",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3"
  }
}
